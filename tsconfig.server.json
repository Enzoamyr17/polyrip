{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".server-build",
    "baseUrl": ".",
    "resolveJsonModule": true
  },
  "include": ["server.ts", "src/**/*", "config/**/*", "app/generated/prisma/**/*"]
}
